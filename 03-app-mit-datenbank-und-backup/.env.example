WP_HOST=blog.example.org

# Backup mit Restic auf S3
# täglich um 12:15 Uhr
BACKUP_CRON=15 12 * * *
# Ziel-Repository: s3:<Endpoint>/<Bucket>/<Unterordner>
RESTIC_REPOSITORY=s3:https://...
# Verschlüsselungspasswort, z. B. mit "openssl rand -base64 32" erzeugen.
# Sicher aufbewahren (Passwortmanager)! Ohne dieses Passwort ist das Backup wertlos.
RESTIC_PASSWORD=...
# S3-Zugangsdaten vom Anbieter
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
