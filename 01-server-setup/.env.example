# E-Mail für Let's Encrypt. Ändern, für @example.org stellt LE kein Zertifikat aus.
ACME_EMAIL=user@example.org

# Zum Testen den Staging-Server von LE nutzen:
#   https://acme-staging-v02.api.letsencrypt.org/directory
# Für echte Zertifikate diesen Server:
ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory

# Hostnamen
DASHBOARD_HOST=traefik.example.org
WHOAMI_HOST=whoami.example.org

#   htpasswd -nB admin
# Wert in einfache Anführungszeichen setzen
DASHBOARD_AUTH='admin:$2y$05$21oFHbc/p420KsADd3ZQR.PLzG5cZVVvzhXHPVh6sXq3tN7OGRk7m'

LOG_LEVEL=INFO