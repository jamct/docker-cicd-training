# Kopieren nach .env und anpassen:  cp .env.example .env

# Hostname der Oberfläche UND der API (DNS muss auf den Server zeigen)
DTRACK_HOST=dtrack.example.org

# Datenbank-Passwort – unbedingt ändern! Erzeugen z. B. mit:  openssl rand -hex 24
POSTGRES_PASSWORD=BitteAendern-Training2026

TZ=Europe/Berlin

# API-Key für den SBOM-Scanner. Erst nach dem ersten Start anlegen (siehe README),
# dann hier eintragen und:  docker compose up -d sbom-scanner
DT_API_KEY=

# Wie oft der Scanner alle laufenden Images erneut erfasst (Sekunden, 86400 = 1 Tag)
SCAN_INTERVAL=86400
