# Hostname der Web-Oberfläche
WUD_HOST=wud.example.org

# Hinweis: Das Passwort darf KEINEN Doppelpunkt (:) enthalten (Einschränkung von WUD).
WUD_ADMIN_USER=admin
WUD_ADMIN_PASSWORD=test123

# Wann sucht WUD nach Updates? Cron-Format
WUD_CRON=0 6 * * *

NGINX_PATCH_HOST=nginx-patch.example.org

# Nur nötig, wenn die Minor-Variante in docker-compose.yml einkommentiert ist
NGINX_MINOR_HOST=nginx-minor.example.org

# Nur nötig, wenn die Variante für manuelle Updates einkommentiert ist
NGINX_MANUAL_HOST=nginx-manual.example.org

TZ=Europe/Berlin
WUD_LOG_LEVEL=info

# Topic-Namen wie ein Passwort behandeln
NTFY_TOPIC=kurs-wud-bitte-zufaellig-waehlen
