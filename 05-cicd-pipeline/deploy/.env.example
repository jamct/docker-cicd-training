#   cp deploy/.env.example deploy/.env
IMAGE=ghcr.io/mein-account/pipeline-demo
# GitLab stattdessen z. B.: IMAGE=registry.gitlab.com/mein-name/pipeline-demo
TAG=latest
APP_HOST=demo.example.org
GREETING=Hallo aus der Pipeline
